{
    "device": "cuda",
    "name": "BiXLSTM1",
    
    "base_path": "../DATA/QTDataset",
    "epochs": 1,
    "batch_size": 256,
    "patience": 5,
    "initial_lr": 0.01,
    "Fs": 250,
    "heart_beats": 1,
    "seq_dur": 1.2,
  
    "f1_eval_interval": 5,
    "target_names": ["No Wave", "P-Wave", "QRS Complex", "T-Wave"],
  
    "use_20_percent": true,
    "label_smoothing": 0.05,
  
    "tolerance_map": {
      "1": 52,
      "2": 48,
      "3": 124
    },

    "model": {
      "name": "bixlstm",
      "params": {
        "input_dim": 1,
        "num_classes": 4,
        "embedding_dim": 32,
        "num_blocks": 5,
        "num_heads": 2,
        "conv1d_kernel_size": 51,
        "proj_factor": 1.0,
        "slstm_at": [1, 3],
        "dropout": 0.3,
        "slstm_backend": "cuda"
      }
    }
  }
