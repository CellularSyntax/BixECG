{
  "device": "cuda",
  "name": "BiXLSTM_Fusion",
  
  "base_path": "../DATA/ptb-xl/",
  "epochs": 50,
  "batch_size": 32,
  "patience": 8,
  "initial_lr": 0.001,
  "Fs": 250,
  "heart_beats": 1,
  "seq_dur": 2.5,
  "db_name": "ptb-xl",

  "f1_eval_interval": 5,
  "target_names": ["NORM", "MI", "STTC", "CD", "HYP"],

  "use_20_percent": false,
  "label_smoothing": 0.05,
  "seed": 42,

  "tolerance_map": {
    "1": 52,
    "2": 48,
    "3": 124
  },

  "model": {
    "name": "bixlstm_fusion",
    "params": {
      "seq_length": 1000,
      "input_dim": 12,
      "embedding_dim": 64,
      "num_blocks": 4,
      "num_heads": 2,
      "conv1d_kernel_size": 21,
      "proj_factor": 1.1,
      "slstm_at": [1, 3],
      "use_slstm": true,
      "dropout": 0.3,
      "num_classes": 5,
      "feature_dim": 192,
      "slstm_backend": "cuda"
    }
  }
}
